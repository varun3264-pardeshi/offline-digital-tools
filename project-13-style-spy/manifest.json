{
  "manifest_version": 3,
  "name": "Style Spy",
  "version": "1.0.0",
  "description": "Inspect and extract any website's color palette, fonts, and typography into reusable CSS variable kits with one click.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inspect Page Styles"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
